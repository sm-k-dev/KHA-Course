Java Bean 설명

public interface PaymentService {
    void pay(int amount);
}

@Service
public class StripePaymentImpl implements PaymentService {
    @Override
    public void pay(int amount) {
        System.out.println("스트라이프 결제: " + amount + "원");
    }
}

@Service
public class CardPaymentImpl implements PaymentService {
    @Override
    public void pay(int amount) {
        System.out.println("카드 결제: " + amount + "원");
    }
}

@Service
public class AccountPaymentImpl implements PaymentService {
    @Override
    public void pay(int amount) {
        System.out.println("계좌이체: " + amount + "원");
    }
}
🎯 @Autowired로 업캐스팅되어 자동 주입받기
java
@Service
public class OrderService {
    
    // 방법 1: 모든 자식들을 List로 받기 (업캐스팅!)
    @Autowired
    private List<PaymentService> allPayments;  // 3개 모두 주입됨!
    
    public void checkout(String method, int amount) {
        // 사용자가 선택한 것 찾기
        PaymentService payment = allPayments.stream()
            .filter(p -> p.getClass().getSimpleName().contains(method))
            .findFirst()
            .orElseThrow();
        
        payment.pay(amount);
    }
}

